# Set to "true" to run entirely on mock data/services (default). No external
# credentials are required in this mode.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Public Supabase project values (safe for the client bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the client. Used by server routes/services
# once the mock booking/payment services are swapped for real ones.
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider secret (server-only), for when MockBookingRepository is
# replaced by a real booking/payment provider.
PAYMENTS_SECRET_KEY=
